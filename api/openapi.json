{
  "components": {
    "schemas": {
      "CitedTextBody": {
        "description": "Serialization copy of both `Risk` and `DifferentiationAngle`.",
        "properties": {
          "sources": {
            "items": {
              "type": "integer"
            },
            "title": "Sources",
            "type": "array"
          },
          "text": {
            "default": "",
            "title": "Text",
            "type": "string"
          }
        },
        "title": "CitedTextBody",
        "type": "object"
      },
      "CompetitorBody": {
        "properties": {
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "funding_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Funding Stage"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "sources": {
            "items": {
              "type": "integer"
            },
            "title": "Sources",
            "type": "array"
          },
          "what_they_do": {
            "default": "",
            "title": "What They Do",
            "type": "string"
          }
        },
        "title": "CompetitorBody",
        "type": "object"
      },
      "CreateReportRequest": {
        "properties": {
          "force": {
            "default": false,
            "title": "Force",
            "type": "boolean"
          },
          "idea": {
            "maxLength": 1500,
            "minLength": 20,
            "title": "Idea",
            "type": "string"
          },
          "target_user": {
            "anyOf": [
              {
                "maxLength": 280,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target User"
          }
        },
        "required": [
          "idea"
        ],
        "title": "CreateReportRequest",
        "type": "object"
      },
      "CreateReportResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "public_slug": {
            "title": "Public Slug",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "public_slug",
          "status"
        ],
        "title": "CreateReportResponse",
        "type": "object"
      },
      "DuplicateError": {
        "description": "You already ran this. Carries the slug so the UI can link to it.",
        "properties": {
          "existing_slug": {
            "title": "Existing Slug",
            "type": "string"
          },
          "reason": {
            "const": "duplicate",
            "default": "duplicate",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "existing_slug"
        ],
        "title": "DuplicateError",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QuotaError": {
        "description": "Why a submission was turned away without spending anything.\n\n`reason` is a closed set so the client's branch is exhaustive rather than\nguessed: these three mean genuinely different things to a user \u2014 \"sign in\nto keep going\", \"you are out of runs this month\", and \"too many free runs\nfrom this address\".",
        "properties": {
          "reason": {
            "enum": [
              "anon_quota",
              "user_quota",
              "ip_rate"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "QuotaError",
        "type": "object"
      },
      "ReportBody": {
        "description": "What a stored report looks like on the way out.\n\nDeliberately *not* `graph.schema.JudgeReport`, even though it mirrors it\nfield for field. `JudgeReport` is a **generation** contract: strict on\npurpose (`risks` needs at least one entry, the verdict must be substantive)\nso a bad judge output fails the run rather than shipping. This is a\n**serialization** contract over rows that are already in the database.\n\nReuse the strict model here and any row written under older rules \u2014 a\npre-rename `competitive_intensity`, a report with zero risks \u2014 turns a\n`GET` into a 500. The user's own paid-for report becomes unservable because\nof a rule that exists to police the LLM. Hence: same shape, no constraints,\nevery list defaulting empty.\n\n`tests/test_api_contract.py` asserts the field sets stay in step.",
        "properties": {
          "citations": {
            "items": {
              "type": "string"
            },
            "title": "Citations",
            "type": "array"
          },
          "competitors": {
            "items": {
              "$ref": "#/components/schemas/CompetitorBody"
            },
            "title": "Competitors",
            "type": "array"
          },
          "degraded_agents": {
            "items": {
              "type": "string"
            },
            "title": "Degraded Agents",
            "type": "array"
          },
          "differentiation": {
            "items": {
              "$ref": "#/components/schemas/CitedTextBody"
            },
            "title": "Differentiation",
            "type": "array"
          },
          "risks": {
            "items": {
              "$ref": "#/components/schemas/CitedTextBody"
            },
            "title": "Risks",
            "type": "array"
          },
          "subscores": {
            "$ref": "#/components/schemas/SubscoresBody"
          },
          "verdict": {
            "default": "",
            "title": "Verdict",
            "type": "string"
          }
        },
        "title": "ReportBody",
        "type": "object"
      },
      "ReportResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "public_slug": {
            "title": "Public Slug",
            "type": "string"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "public_slug",
          "status",
          "step",
          "error",
          "score",
          "report",
          "created_at",
          "updated_at"
        ],
        "title": "ReportResponse",
        "type": "object"
      },
      "ReportSummary": {
        "description": "History row. Deliberately not the full report: the body is tens of KB.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "idea": {
            "title": "Idea",
            "type": "string"
          },
          "public_slug": {
            "title": "Public Slug",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "public_slug",
          "status",
          "score",
          "idea",
          "created_at"
        ],
        "title": "ReportSummary",
        "type": "object"
      },
      "SubscoresBody": {
        "description": "Serialization copy of `Subscores`. No `ge`/`le` \u2014 see `ReportBody`.",
        "properties": {
          "competitive_headroom": {
            "default": 0,
            "title": "Competitive Headroom",
            "type": "integer"
          },
          "feasibility": {
            "default": 0,
            "title": "Feasibility",
            "type": "integer"
          },
          "market_size": {
            "default": 0,
            "title": "Market Size",
            "type": "integer"
          },
          "novelty": {
            "default": 0,
            "title": "Novelty",
            "type": "integer"
          },
          "timing": {
            "default": 0,
            "title": "Timing",
            "type": "integer"
          }
        },
        "title": "SubscoresBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "IdeaCheck API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/claim": {
      "post": {
        "description": "Reassign an anonymous visitor's reports to the signed-in caller.",
        "operationId": "claim_anonymous_reports_auth_claim_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-anon-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Anon-Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Claim Anonymous Reports Auth Claim Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Claim Anonymous Reports",
        "tags": [
          "auth"
        ]
      }
    },
    "/corpus/stats": {
      "get": {
        "operationId": "corpus_stats_corpus_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Corpus Stats Corpus Stats Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Corpus Stats",
        "tags": [
          "corpus"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/reports": {
      "get": {
        "description": "The caller's own reports, newest first.\n\nAn explicit join rather than a relationship: `models.py` declares none, and\nasync SQLAlchemy turns a forgotten eager-load into a runtime error.",
        "operationId": "list_reports_reports_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-anon-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Anon-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ReportSummary"
                  },
                  "title": "Response List Reports Reports Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Reports",
        "tags": [
          "reports"
        ]
      },
      "post": {
        "operationId": "create_report_reports_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-anon-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Anon-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateReportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateError"
                }
              }
            },
            "description": "You already ran this idea recently."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaError"
                }
              }
            },
            "description": "Free run used, quota exhausted, or rate limited."
          }
        },
        "summary": "Create Report",
        "tags": [
          "reports"
        ]
      }
    },
    "/reports/{public_slug}": {
      "get": {
        "operationId": "get_report_reports__public_slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "public_slug",
            "required": true,
            "schema": {
              "title": "Public Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Report",
        "tags": [
          "reports"
        ]
      }
    }
  }
}
