# Copy to api/.env for local development.

DATABASE_URL=postgresql+psycopg://ideacheck:ideacheck@localhost:5433/ideacheck

# Bounded concurrent graph runs in-process.
MAX_CONCURRENT_RUNS=5

CORS_ORIGINS=http://localhost:3000

# --- Phase 2: research + judge ---
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Research tier. sonar-pro while evaluating whether the reports are any good:
# discovering the output is shallow on the cheap tier can't distinguish "the
# idea doesn't work" from "the research was underpowered".
SONAR_MODEL=sonar-pro

# Judge tier. The judge is the quality bottleneck of the whole product.
JUDGE_MODEL=claude-opus-5

# Concurrent Perplexity requests, sized independently of MAX_CONCURRENT_RUNS:
# that bounds reports in flight, this bounds requests to a vendor. One run makes
# four calls, so 5 runs would otherwise mean 20 concurrent Sonar requests.
PERPLEXITY_CONCURRENCY=8
RESEARCH_TIMEOUT_S=90
RESEARCH_RETRY_ATTEMPTS=3
RESEARCH_RETRY_BASE_DELAY_S=1.0

# --- Phase 4: identity + spend control ---
# Clerk. Fatal when unset: unlike the embedding key, nothing works without it.
# Must be the JWKS document itself, not the instance root: the Clerk domain
# answers 200 with an empty body, so a bare domain here fails every token
# silently as "not authenticated" rather than erroring at startup.
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# Optional; when set, the `iss` claim is verified against it too.
CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev

# Free quota. The anonymous run is marketing spend; the account limit is the
# real ceiling. Anonymous runs are counted under the sentinel period 'anon'
# rather than a month, because the id lives in localStorage and would otherwise
# earn a fresh free run every month boundary.
ANON_FREE_RUNS=1
MONTHLY_FREE_RUNS=5

# The actual ceiling on anonymous traffic: the X-Anon-Id header is forgeable by
# curl, so this is what stands between a for-loop and the Anthropic bill.
# NOTE: behind a proxy, uvicorn must run with --proxy-headers or every visitor
# shares one bucket.
ANON_RUNS_PER_IP=3

# Cheap classifier in front of the expensive pipeline.
PRECHECK_MODEL=claude-haiku-4-5

# --- Phase 3: corpus embeddings ---
# Optional: without it, corpus rows are still written but with NULL embeddings
# (repairable later via `make backfill`).
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# --- Tracing (optional but recommended) ---
# The LangSmith SDK reads os.environ directly, not our Settings object.
# app/config.py exports this file into os.environ at import time for exactly
# that reason — without it these are parsed into nothing and tracing is silently
# off, with no error and no traces.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ideacheck
